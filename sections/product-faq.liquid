{% style %}
    .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  .custom_accordian  [aria-expanded="true"]{
    background:{{section.settings.acc_bg_clr}} !important;
  }
  .custom_accordian summary {
    padding-left:10px;
  }
   .custom_accordian  [aria-expanded="true"] .accordion__title{
     color:{{section.settings.text_bg_clr}} !important;
   }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{% endstyle %}

{% assign faqs = product.metafields.custom.product_faq.value %}
{% if faqs != blank %}
  <section
    class="section-{{ section.id }}-padding text-center page-width"
    data-section-type="sf-collapsible"
    data-section-id="{{ section.id }}"
  >
    {% if section.settings.title != blank %}
      <h2 class=" center h1 font-body-bold">{{ section.settings.title }}</h2>
    {% endif %}

    {% for i in (1..5) %}
      {% assign title = 'title_' | append: i %}
      {% assign answer = 'answer_' | append: i %}

      <div
        class="accordion custom_accordian {% if section.settings.layout == 'row' %} content-container color-{{ section.settings.container_color_scheme }} gradient{% endif %}"
        {{ block.shopify_attributes }}
      >
        <details
          id="Details-{{ block.id }}-{{ section.id }}"
          {% if section.settings.open_first_collapsible_row and forloop.first %}
            open
          {% endif %}
        >
          <summary id="Summary-{{ block.id }}-{{ section.id }}">
            <h3 class="accordion__title inline-richtext h4">
              {{ faqs[title] }}
            </h3>
            {% render 'icon-caret' %}
          </summary>
          <div
            class="accordion__content rte"
            id="CollapsibleAccordion-{{ block.id }}-{{ section.id }}"
            role="region"
            aria-labelledby="Summary-{{ block.id }}-{{ section.id }}"
          >
            {{ faqs[answer] | metafield_tag }}
          </div>
        </details>
      </div>
    {% endfor %}
  </section>
{% endif %}

{% schema %}
{
  "name": "Product Faq",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
          {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottm",
      "default": 52
    },
    {
      "type": "color",
      "id": "acc_bg_clr",
      "label": "Accordian Background",
      "default":"#f2f7f6"
    },
        {
      "type": "color",
      "id": "text_bg_clr",
      "label": "Text Color",
          "default":"#2ab673"
    }
  ],
  "presets": [
    {
      "name": "Product Faq"
    }
  ]
}
{% endschema %}
